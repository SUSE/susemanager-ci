pipeline {
    agent {
        label 'sumaform-cucumber'
    }

    options {
        // Keeps the console clean and adds timestamps
        timestamps()
        // Prevents the job from hanging forever if SSH or Docker operations hang
        timeout(time: 30, unit: 'MINUTES')
        ansiColor('xterm')
    }

    parameters {
        choice(
            name: 'BUILD_TYPE',
            choices: ['branch', 'container'],
            description: 'Select "branch" to build from source or "container" to use an existing image.'
        )
        string(
            name: 'CONTAINER_IMAGE',
            defaultValue: '',
            description: 'The full name of the container image to use (e.g., "my-registry/my-image:latest"). Only used if BUILD_TYPE is "container".'
        )
        string(
            name: 'MCP_SERVER_BRANCH',
            defaultValue: 'main',
            description: 'The branch to check out from the mcp-server-uyuni repository.'
        )
        string(
            name: 'AGENT_MODEL',
            defaultValue: 'gemini-3.1-flash-lite',
            description: 'The model to use for the AI agent during testing.'
        )
        string(
            name: 'JUDGE_MODEL',
            defaultValue: 'gemini-3.1-flash-lite',
            description: 'The model to use for the AI judge during testing.'
        )
    }

    environment {
        AGENT_MODEL = "${params.AGENT_MODEL}"
        JUDGE_MODEL = "${params.JUDGE_MODEL}"
    }

    stages {
        stage('Revert Snapshot') {
            steps {
                echo 'Reverting environment to clean state...'
                sh 'ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=10 root@suma-09.mgr.suse.de revert-last-snapshot-env.sh mlm-test-ai'
            }
        }

        stage('Initialize') {
            steps { script { dockerTag = '' } }
        }

        stage('Checkout Code') {
            steps {
                echo 'Checking out mcp-server-uyuni...'
                git url: 'https://github.com/uyuni-project/mcp-server-uyuni.git', branch: params.MCP_SERVER_BRANCH
            }
        }

        stage('Build Test Image') {
            steps {
                script {
                    dockerTag = "${env.JOB_NAME.toLowerCase().replaceAll(/[^a-z0-9]/, '-')}"
                    echo "Building Docker image: ${dockerTag}"
                    sh "/usr/lib/docker/cli-plugins/docker-buildx build -f Dockerfile.test -t ${dockerTag} ."
                }
            }
        }

        stage('Prepare Configuration') {
            steps {
                echo 'Generating environment configuration...'
                sh '''
                    [ -d .venv ] || mkdir .venv
                    touch .venv/config
                    chmod 600 .venv/config
                    cat <<EOF > .venv/config
UYUNI_SERVER=mlm-test-ai-server.mgr.suse.de
UYUNI_MCP_WRITE_TOOLS_ENABLED=true
UYUNI_MCP_TRANSPORT=stdio
UYUNI_MCP_LOG_FILE_PATH=/tmp/mcp-server-uyuni.log
UYUNI_MCP_LOG_LEVEL=DEBUG
UYUNI_MCP_SSL_VERIFY=false
UYUNI_USER=admin
UYUNI_PASS=admin
EOF
                '''
                script {
                    if (params.BUILD_TYPE == 'container') {
                        echo "BUILD_TYPE is container, generating test_config.json to run against ${params.CONTAINER_IMAGE}"
                        // The docker client inside the test runner is just a remote for the host's docker daemon.
                        // Therefore, all paths must be absolute paths on the HOST.
                        // The --env-file argument must be a single string to prevent the client from trying to access the path.
                        def configJson = """{"mcpServers": {"mcp-server-uyuni": {"command": "docker", "args": ["run", "--network=host", "--env-file=/app/.venv/config", "-i", "--rm", "${params.CONTAINER_IMAGE}"]}}}"""
                        writeFile(file: 'test/config.json.container', text: configJson)
                    }
                }
            }
        }

        stage('Run Acceptance Tests') {
            when { expression { params.BUILD_TYPE == 'branch' } }
            steps {
                echo 'Running Dockerized tests...'
                script {
                    sh '''
                        set -e
                        if [ ! -f "$HOME/.ai_secrets" ]; then
                            echo "ERROR: Required env file $HOME/.ai_secrets not found."
                            echo "Please provision this file on the agent or generate it via Jenkins credentials in the workspace."
                            exit 1
                        fi
                    '''
                    sh """
                        set -e
                        if [ -z "${dockerTag}" ]; then
                            echo "ERROR: The Docker image tag is not set. Cannot run tests."
                            exit 1
                        fi
                        docker run --rm \
                                   --env-file .venv/config \
                                   -e AGENT_MODEL=${env.AGENT_MODEL} \
                                   -e JUDGE_MODEL=${env.JUDGE_MODEL} \
                                   --env-file \$HOME/.ai_secrets \
                                   -v "\$(pwd)/results:/app/results" \
                                   -v /var/run/docker.sock:/var/run/docker.sock \
                                   -v "\$(pwd)/test/test_config.json:/app/test_config.json" \
                                   --network=host \
                                   "${dockerTag}" -s test/test_deepeval.py --junit-xml=results/results.xml
                    """
                }
            }
        }

        stage('Run Acceptance Tests (Container)') {
            when { expression { params.BUILD_TYPE == 'container' } }
            steps {
                echo 'Running Dockerized tests against a container image...'
                script {
                    sh """
                        set -e
                        docker run --rm \
                                   --env-file .venv/config \
                                   -e AGENT_MODEL=${env.AGENT_MODEL} \
                                   -e JUDGE_MODEL=${env.JUDGE_MODEL} \
                                   --env-file \$HOME/.ai_secrets \
                                   -v "\$(pwd)/results:/app/results" \
                                   -v /var/run/docker.sock:/var/run/docker.sock \
                                   -v "\$(pwd)/test/config.json.container:/app/config.json" \
                                   -v "\$(pwd)/test/test_config.json:/app/test_config.json" \
                                   -v "\$(pwd)/.venv/config:/app/.venv/config" \
                                   --network=host \
                                   "${dockerTag}" -s test/test_deepeval.py --junit-xml=results/results.xml
                    """
                }
            }
        }

        stage('Cleanup') {
            steps {
                echo 'Cleaning up Docker images and local config...'
                sh "if [ -n \"${dockerTag}\" ]; then docker rmi ${dockerTag} || echo 'Image not found or could not be removed.'; fi"
                sh "rm -f .venv/config"
            }
        }
    }

    post {
        always {
            // Archive JUnit Results
            junit testResults: 'results/results.xml', allowEmptyResults: true
            
            // Publish HTML Report
            publishHTML([
                allowMissing: true,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: 'results',
                reportFiles: 'report.html',
                reportName: 'DeepEval HTML Results',
                reportTitles: 'DeepEval Test Report'
            ])
        }

        unstable {
            emailext (
                to: 'discuss-mlm-ai-test-r-aaaatphnhqm7cvlkd7xpw7vlh4@suse.slack.com',
                subject: "Unstable Build: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: "Tests finished with some failures. Check results at ${env.BUILD_URL}",
                attachLog: true
            )
        }

        failure {
            emailext (
                to: 'discuss-mlm-ai-test-r-aaaatphnhqm7cvlkd7xpw7vlh4@suse.slack.com',
                subject: "Build Failed: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: "The build failed before completion. See logs: ${env.BUILD_URL}",
                recipientProviders: [[$class: 'CulpritsRecipientProvider'], [$class: 'DevelopersRecipientProvider']]
            )
        }
    }
}
