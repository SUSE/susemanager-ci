#!/usr/bin/env groovy

// Configure the build properties
properties([
        buildDiscarder(logRotator(numToKeepStr: '500'))
])

pipeline {

    options {
        timeout(time: 30, unit: 'MINUTES') 
        ansiColor('xterm')
    }

    parameters {
        string(defaultValue: '', description: 'SUSE Manager PR', name: 'PR_NUMBER')
        booleanParam(defaultValue: true, description: 'Clean up workspace after a successful execution.', name: 'cleanWorkspace')
    }

    environment {
        repository = "SUSE/spacewalk"
        cmd = "pr-checker --repo ${repository} run " +
                " --pr ${params.PR_NUMBER} " +
                " --build-url ${env.BUILD_URL}"
        changelog_test = "${cmd} --check-name changelog_test " +
                " --command /var/lib/jenkins/bin/changelog.rb " +
                " --description \"test if changelog was updated\" "

        enable_merging = "${cmd} --check-name merge_enabled " +
                " --description \"Merging enabled (requires changelog_test passing)\" "
    }
    // run only on specific hosts
    agent { label 'suse-manager-unit-tests' }

    stages {
        stage('Clean Up Workspace') {
            steps {
                echo 'Clean up previous workspace'
                cleanWs()
                echo 'Check out SCM'
                checkout scm
            }
        }

        stage('Run changelog test') {
            steps {
                echo 'Run changelog tests'
                script {
                    if (params.PR_NUMBER != '') {
                        currentBuild.displayName = "PR: ${params.PR_NUMBER}"
                        sh (
                           "set +e; export PRODUCT=SUSE-Manager REPO=${repository} PR_NUMBER=${params.PR_NUMBER}; ${changelog_test}; CLRET=\${?}; " +
                           "if [ \$CLRET -eq 0 ]; then " +
                           "${enable_merging} --command /usr/bin/true; " +
                           "else ${enable_merging} --command /usr/bin/false; " +
                           "fi; exit \$CLRET"
                        )
                    } else {
                        echo "Missing PR_NUMBER parameter"
                    }
                }
            }
        }
    }
    // postactions
    post {
        success {
            script {
                if (params.cleanWorkspace == true) {
                    echo 'Clean up current workspace, when job success.'
                    cleanWs()
                }
            }
        }
    }
}
