#!/usr/bin/env groovy

node('sumaform-cucumber') {
    properties([
        buildDiscarder(logRotator(numToKeepStr: '15', artifactNumToKeepStr: '5')),
        disableConcurrentBuilds(),
        parameters([
            string(name: 'sumaform_gitrepo', defaultValue: 'https://github.com/uyuni-project/sumaform.git', description: 'Sumaform Git Repository'),
            string(name: 'sumaform_ref', defaultValue: 'master', description: 'Sumaform Git reference (branch, tag...)'),
            string(name: 'deploy_parallelism', defaultValue: '', description: 'Advanced: Define the number of parallel resource operations for the executable binary'),
            string(name: 'terracumber_gitrepo', defaultValue: 'https://github.com/uyuni-project/terracumber.git', description: 'Terracumber Git Repository'),
            string(name: 'terracumber_ref', defaultValue: 'master', description: 'Terracumber Git ref (branch, tag...)'),
            string(name: 'aws_region', defaultValue: 'eu-west-1', description: 'Describe the AWS region where to deploy the infrastructure'),
            string(name: 'aws_availability_zone', defaultValue: 'eu-west-1a', description: 'Describe the AWS availability zone where to deploy the infrastructure'),
            string(name: 'infra_name_prefix', defaultValue: 'mlm-bv-aws-', description: 'Name prefix of the shared AWS infrastructure (VPC, bastion, mirror), to be passed to the AWS BV pipelines'),
            string(name: 'key_file', defaultValue: '/home/jenkins/.ssh/testing-suma.pem', description: 'Path to SSH private key to access instance in AWS'),
            string(name: 'key_name', defaultValue: 'testing-suma', description: 'SSH key name in AWS'),
            text(name: 'allowed_IPS', defaultValue: '195.135.223.0/24', description: 'Public IPs or CIDRs allowed to SSH into the bastion, separated by new line: keep the Jenkins workers and the suma-05 mirror, add your own if needed'),
            booleanParam(name: 'deploy_mirrors', defaultValue: true, description: 'Deploy the suma-05 and AWS mirrors and sync the repositories. If unchecked, only the VPC, private network and bastion are deployed, and an AWS mirror from a previous run is destroyed'),
            booleanParam(name: 'destroy_environment', defaultValue: false, description: 'Destroy the infrastructure and the suma-05 mirror deployed by the previous runs instead of deploying. Destroy the server pipelines environments first'),
            booleanParam(name: 'confirm_destroy', defaultValue: false, description: 'Confirm destroy_environment: both must be checked'),
            text(name: 'mi_ids', defaultValue: '', description: 'MI Identifiers separated by comma and whitespaces (Option A)'),
            text(name: 'custom_repositories', defaultValue: '{}', description: 'Salt & Client Tools MU Repositories for each client, in json format (Option B)'),
        ])
    ])

    stage('Checkout pipeline') {
        checkout scm
    }
    def mutableParams = [:] + params
    mutableParams.json_generator_version = "52-micro"
    mutableParams.bin_path = "/usr/bin/tofu"
    mutableParams.bin_plugins_path = "/usr/bin"

    def pipeline = load "jenkins_pipelines/environments/common/pipeline-build-validation-aws-infra.groovy"

    withCredentials([file(credentialsId: 'aws-secrets', variable: 'AWS_SHARED_CREDENTIALS_FILE')]) {
        pipeline.run(mutableParams)
    }
}
